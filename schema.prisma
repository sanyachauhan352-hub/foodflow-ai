datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Process {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String
  temperature String   @default("Ambient")
  duration    String   @default("N/A")
  compliance  String   // Stores compliance codes as a JSON-serialized string (e.g. '["HACCP", "FDA"]')
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
